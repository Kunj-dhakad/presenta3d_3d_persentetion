{
  "name": "strata",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:openai": "vitest run --config vitest.integration.config.mts",
    "check:schemas": "tsx scripts/check-ai-schemas.ts",
    "db:generate": "prisma generate --schema prisma/schema.prisma && prisma generate --schema prisma/mysql/schema.prisma",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:check": "node --conditions=react-server --import tsx --import dotenv/config scripts/check-rds-connection.ts",
    "db:seed": "tsx --conditions=react-server prisma/seed.ts",
    "db:use-postgres": "node scripts/derive-postgres-schema.mjs",
    "db:use-mysql": "node scripts/derive-mysql-schema.mjs",
    "postinstall": "prisma generate --schema prisma/schema.prisma && prisma generate --schema prisma/mysql/schema.prisma",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "fix:tailwind": "node scripts/canonicalize-tailwind.mjs --write",
    "check:tailwind": "node scripts/canonicalize-tailwind.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "d3": "^7.9.0",
    "esbuild": "^0.28.2",
    "gsap": "^3.15.0",
    "lucide-react": "^1.61.0",
    "monaco-editor": "^0.57.0",
    "motion": "^14.5.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "openai": "^7.39.0",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-resizable-panels": "^4.14.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/d3": "^7.4.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^18.0.8",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.3",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  },
  "engines": {
    "node": ">=22.12"
  }
}
