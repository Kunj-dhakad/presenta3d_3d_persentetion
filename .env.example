# ─── Strata configuration ────────────────────────────────────────────────
# Copy to `.env` (or `.env.local` for Next.js only) and fill in real values.
# Never commit real credentials. None of these are exposed to the browser:
# do NOT rename any of them with a NEXT_PUBLIC_ prefix.

# OpenAI (server-side only)
OPENAI_API_KEY=
# Model used for planning / code generation via the Responses API, e.g. gpt-5.4
OPENAI_MODEL=
# Optional overrides for media generation (left empty = feature reports "not configured")
OPENAI_IMAGE_MODEL=
OPENAI_VIDEO_MODEL=
OPENAI_TTS_MODEL=
# Optional pricing (USD per 1M tokens) used to estimate cost in usage records
OPENAI_PRICE_INPUT_PER_1M=
OPENAI_PRICE_OUTPUT_PER_1M=
# Request timeout in ms for a single model call (default 120000)
OPENAI_TIMEOUT_MS=

# Database. SQLite for local development:
DATABASE_URL="file:./.data/strata.db"
# PostgreSQL for production (run `npm run db:use-postgres` first):
# DATABASE_URL="postgresql://user:password@localhost:5432/strata?schema=public"

# Session signing secret: at least 32 random characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Public origin of this app (used for CSRF origin checks and share URLs)
APP_ORIGIN=http://localhost:3000

# Optional: serve previews from a separate origin in production
# (e.g. https://preview.example-usercontent.com). Empty = same server with CSP sandbox.
PREVIEW_ORIGIN=

# Storage adapter: "local" (default, ./.data/storage) or "s3"
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Publishing adapter: "local" (default; serves /sites/<slug> from this server) or "vercel"
PUBLISH_PROVIDER=local
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Optional external providers for modalities OpenAI does not offer
# (3D model generation, sound effects). Leave empty to show "not configured".
MESHY_API_KEY=
ELEVENLABS_API_KEY=

# Limits
MAX_REPAIR_ATTEMPTS=2
AGENT_CONCURRENCY=3
GENERATION_RATE_LIMIT_PER_MIN=6

# Testing only: AI_PROVIDER=mock uses a deterministic offline provider.
# Never set this in production.
AI_PROVIDER=openai
