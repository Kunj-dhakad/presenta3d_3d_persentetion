# This app only runs inside the PHP app (CI_Core): its 3D presentation pages open it in an iframe.

# OpenAI (server-side only)
OPENAI_API_KEY=
# Model used for planning / code generation via the Responses API, e.g. gpt-5.4
OPENAI_MODEL=
# Optional overrides for media generation (left empty = feature reports "not configured")
OPENAI_IMAGE_MODEL=
OPENAI_VIDEO_MODEL=
OPENAI_TTS_MODEL=
# Optional pricing (USD per 1M tokens) used to estimate cost in usage records
OPENAI_PRICE_INPUT_PER_1M=
OPENAI_PRICE_OUTPUT_PER_1M=
# Request timeout in ms for a single model call (default 120000)
OPENAI_TIMEOUT_MS=

# Database: the PHP app's (CI_Core) MySQL database. This app keeps its tables there with a p3d_ prefix
# (create them with application/sql/p3d_tables.sql in CI_Core, or npm run db:deploy).
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
# Set only for Playwright: a separate, disposable RDS database used by E2E tests.
E2E_MYSQL_DATABASE=

# There is no login here: the PHP page hands over the user's access token (INIT_DATA).
# Key PHP signs it with (encrypt_user_token); empty = PHP's default.
PHP_TOKEN_KEY=
# Comma-separated PHP origins allowed to send INIT_DATA, e.g. https://present3d.com,https://*.present3d.com
# Empty accepts any (development only). Read at build time.
NEXT_PUBLIC_PARENT_ORIGINS=
# Extra sites allowed to frame this app (space separated; present3d.com is built in). Read at build time.
FRAME_ANCESTORS=

# Public origin of this app (used for CSRF origin checks and share URLs)
APP_ORIGIN=http://localhost:3000

# Optional: serve previews from a separate origin in production
# (e.g. https://preview.example-usercontent.com). Empty = same server with CSP sandbox.
PREVIEW_ORIGIN=

# Storage: "local" keeps media, build previews and published sites under ./.data (development);
# "s3" stores them in the PHP app's bucket (production).
STORAGE_DRIVER=local
# The PHP app's S3 bucket and credentials (the same ones CI_Core uploads with).
KD_AWS_S3_BUCKET_NAME=
KD_AWS_REGION=
KD_AWS_ACCESS_KEY_ID=
KD_AWS_SECRET_ACCESS_KEY=
# Folder inside that bucket for this app's files.
S3_ROOT_PREFIX=assets/uploads/3d_presentations/
# Optional S3-compatible endpoint (leave empty for AWS S3); legacy S3_* names are also accepted.
S3_ENDPOINT=

# Publishing adapter: "local" (default; serves /sites/<slug> from this server) or "vercel"
PUBLISH_PROVIDER=local
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Optional external providers for modalities OpenAI does not offer
# (3D model generation, sound effects). Leave empty to show "not configured".
MESHY_API_KEY=
ELEVENLABS_API_KEY=

# Limits
MAX_REPAIR_ATTEMPTS=2
AGENT_CONCURRENCY=3
GENERATION_RATE_LIMIT_PER_MIN=6

# Testing only: AI_PROVIDER=mock uses a deterministic offline provider.
# Never set this in production.
AI_PROVIDER=openai
